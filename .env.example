APP_NAME=orchestrator-service
ENVIRONMENT=local

# Servidor: main.py lanza uvicorn con estos valores (local y en Docker).
# Local, junto a pdf-extractext (:8000) y document-store (:8002): PORT=8001.
HOST=0.0.0.0
PORT=8000
# true activa el reload de uvicorn: solo para desarrollo.
DEBUG=false
# IPs o redes (CIDR) de las que se aceptan los headers X-Forwarded-*.
# Detras de Traefik: la subred de la red del compose, p. ej. 172.28.0.0/16
FORWARDED_ALLOW_IPS=127.0.0.1
# Segundos que uvicorn espera las requests en curso al recibir SIGTERM
# (menor que el stop_grace_period del compose).
GRACEFUL_SHUTDOWN_SECONDS=60

# URL base del microservicio de extraccion de texto (pdf-extractext).
# Local: http://localhost:8000 | Docker: http://pdf-extractext:8000 (nombre de servicio)
PDF_EXTRACT_BASE_URL=http://localhost:8000

# URL base del microservicio que guarda los documentos (document-store).
# Local: http://localhost:8002 | Docker: http://document-store:8000
DOCUMENT_STORE_BASE_URL=http://localhost:8002

# Timeouts de lectura/escritura en segundos, uno por microservicio. pdf-extractext responde 503
# antes de 25 s si no llega a extraer: el timeout tiene que ser mayor para recibir ese 503.
# (HTTP_TIMEOUT_SECONDS, el nombre anterior, sigue configurando el de pdf-extractext.)
PDF_EXTRACT_TIMEOUT_SECONDS=30
DOCUMENT_STORE_TIMEOUT_SECONDS=5
# Timeout solo para conectar: mas corto, para fallar rapido si un servicio esta caido
HTTP_CONNECT_TIMEOUT_SECONDS=2

# Retry: intentos maximos (contando el primero) y espera exponencial con jitter (segundos).
# Solo se reintentan fallos de conexion y 5xx en metodos idempotentes; nunca un timeout de POST.
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=0.2
RETRY_MAX_BACKOFF_SECONDS=2.0

# Circuit Breaker: fallos consecutivos para abrir el circuito y segundos abierto antes de probar (half-open).
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# Bulkhead (uno por microservicio): requests en vuelo, cuantas pueden esperar un lugar y por cuantos segundos.
BULKHEAD_MAX_CONCURRENT=5
BULKHEAD_MAX_WAITING=10
BULKHEAD_ACQUIRE_TIMEOUT_SECONDS=5

# Tamano maximo del PDF (10 MB, igual que pdf-extractext). Mas grande: 413 sin terminar de leerlo.
MAX_PDF_SIZE_BYTES=10485760
